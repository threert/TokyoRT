{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 2,
    "paths": {
      "@dgreenheck/ez-tree": ["./node_modules/@dgreenheck/ez-tree/src/lib/index.js"]
    },
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["scene", "tools"]
}
